# ─── Azure AI Foundry (PRIMARY — required for Agents League competition) ──────
AZURE_AI_PROJECT_CONNECTION_STRING=<region>.api.cognitive.microsoft.com;SubscriptionId=<id>;ResourceGroup=<rg>;ProjectName=<name>
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# ─── Foundry IQ — Azure AI Search (for grounded medical knowledge) ───────────
FOUNDRY_IQ_ENDPOINT=https://<your-service>.search.windows.net
FOUNDRY_IQ_INDEX_NAME=sleepiq-medical-knowledge
FOUNDRY_IQ_API_KEY=<your-search-admin-key>

# ─── Gemini (Google AI Studio) (fallback for local dev without Azure) ───────────────────────
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ─── Azure OpenAI (optional fallback) ────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ─── OpenAI Direct (optional fallback) ───────────────────────────────────────
OPENAI_API_KEY=

# ─── App Config ───────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_SECRET_KEY=your-secret-key-here
DEBUG=false
